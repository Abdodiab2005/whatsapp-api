{
  "name": "whatsapp-newsletter-api",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted HTTP API for sending WhatsApp private and channel messages through Baileys.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "ci": "biome ci",
    "test": "node --test",
    "docs:check": "node scripts/checkDocs.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "api",
    "self-hosted",
    "newsletter",
    "channel",
    "express"
  ],
  "author": "Abdodiab2005",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "audio-decode": "2.2.3",
    "chalk": "^4.1.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "21.3.4",
    "libphonenumber-js": "^1.13.12",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "sharp": "0.35.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdodiab2005/whatsapp-api.git"
  },
  "bugs": {
    "url": "https://github.com/Abdodiab2005/whatsapp-api/issues"
  },
  "homepage": "https://github.com/Abdodiab2005/whatsapp-api#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  }
}
